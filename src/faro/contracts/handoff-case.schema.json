{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banking-agent:card-support:handoff-case:1",
  "title": "Card support handoff case",
  "description": "One item of the handoff cases table (ADR-0007, Handoffs as cases, and its amendments of 2026-09-30): a case, saved as a draft or filed, or the item that holds a reference for the one case that took it. file_handoff writes both, in one transaction when it files a case; the console reads them. A filed case's payload is the handoff as filed, valid against the handoff schema, and never changes. Its status would change only through claim and resolve, which the prototype defers, so every case stays filed. Items expire 90 days after their case is filed, or saved as a draft (OPS-10).",
  "oneOf": [
    { "$ref": "#/$defs/draft_case" },
    { "$ref": "#/$defs/filed_case" },
    { "$ref": "#/$defs/reference_item" }
  ],
  "$defs": {
    "customer_id": { "type": "string", "pattern": "^CLI-[A-Z0-9]{12}$" },
    "product_id": { "type": "string", "pattern": "^PRD-[A-Z0-9]{12}$" },
    "origin_jti": {
      "description": "The sign-in: Cognito's origin_jti, the policy's session (POL-09). It chooses the sandbox overlay a tool reads and writes.",
      "type": "string",
      "format": "uuid"
    },
    "wall_time": {
      "description": "Wall clock, UTC (ADR-0004, Two clocks).",
      "type": "string",
      "format": "date-time"
    },
    "language": {
      "description": "The conversation's language (POL-50).",
      "enum": ["es", "pt"]
    },
    "block_reason": { "enum": ["lost", "stolen", "unrecognized_charge", "customer_request"] },
    "reason_code": {
      "enum": [
        "unrecognized_charge",
        "customer_request",
        "complaint",
        "unblock_request",
        "customer_not_active",
        "ambiguous_card",
        "action_not_verified",
        "block_lapsed",
        "unsupported_request",
        "clarification_failed",
        "record_conflict",
        "missing_data",
        "tool_failure"
      ]
    },
    "reference": {
      "description": "A handoff's reference: eight characters of Crockford's base32, in two groups of four (ADR-0007).",
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$"
    },
    "validation_error": {
      "description": "A path and the rule it broke, never the value (POL-11).",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rule"],
      "properties": {
        "path": { "type": "string", "maxLength": 256 },
        "rule": { "type": "string", "pattern": "^[A-Za-z]{1,32}$" }
      }
    },
    "turn_prefix": {
      "description": "A turn's place in the sign-in's execution record: the start and the turn's ID that begin each of its entry keys (ADR-0007's amendment of 2026-09-30).",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z#[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "text": {
      "description": "Free text, in Spanish (POL-46). A run of 13 or more digits, spaced or not, could be a card number, so it is rejected (POL-11).",
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "[0-9](?:[ -]?[0-9]){12,}" }
    },
    "source": {
      "description": "From the groups of the token that filed the case, so an evaluation's cases never reach a human agent's queue (EVL-13; ADR-0007's amendment of 2026-09-30).",
      "enum": ["demo", "evaluation"]
    },
    "expires_at": {
      "description": "Epoch seconds, for DynamoDB's time to live.",
      "type": "integer",
      "minimum": 0
    },
    "draft_case": {
      "description": "A case saved when the confirm control shows, with what the graph knows then, filed when its confirmation ends within a turn and otherwise left to expire (ADR-0004's amendment of 2026-09-29). The queue doesn't show it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["pk", "kind", "handoff_id", "customer_id", "status", "source", "saved_at", "draft", "expires_at"],
      "properties": {
        "pk": { "description": "The handoff's ID.", "type": "string", "format": "uuid" },
        "kind": { "const": "case" },
        "handoff_id": { "type": "string", "format": "uuid" },
        "customer_id": { "$ref": "#/$defs/customer_id" },
        "status": { "const": "draft" },
        "source": { "$ref": "#/$defs/source" },
        "saved_at": { "$ref": "#/$defs/wall_time" },
        "draft": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sign_in", "language", "reason_code", "confirmation_id", "card_id", "reason"],
          "properties": {
            "sign_in": { "$ref": "#/$defs/origin_jti" },
            "language": { "$ref": "#/$defs/language" },
            "reason_code": { "enum": ["unrecognized_charge", "block_lapsed"] },
            "confirmation_id": { "type": "string", "format": "uuid" },
            "card_id": { "$ref": "#/$defs/product_id" },
            "reason": { "$ref": "#/$defs/block_reason" }
          }
        },
        "expires_at": { "$ref": "#/$defs/expires_at" }
      }
    },
    "filed_case": {
      "description": "A filed case, which the queue lists by its source, queue, and status (the by_queue index), urgent cases first and each priority's newest first. flagged says that parts of the payload failed a check and were left out or replaced, each named by its path and the rule it broke, never its value, so the console shows the case as flagged (ADR-0004, The handoff).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pk",
        "kind",
        "handoff_id",
        "customer_id",
        "reference",
        "payload",
        "queue",
        "priority",
        "reason_code",
        "language",
        "source",
        "status",
        "queue_key",
        "queue_order",
        "filed_at",
        "flagged",
        "validation_errors",
        "record",
        "expires_at"
      ],
      "properties": {
        "pk": { "description": "The handoff's ID.", "type": "string", "format": "uuid" },
        "kind": { "const": "case" },
        "handoff_id": { "type": "string", "format": "uuid" },
        "customer_id": { "$ref": "#/$defs/customer_id" },
        "reference": { "$ref": "#/$defs/reference" },
        "payload": {
          "description": "The handoff as filed, valid against the handoff schema (POL-46), with the facts file_handoff added; never changed afterwards.",
          "type": "object",
          "required": ["schema_version", "handoff_id"]
        },
        "queue": { "enum": ["customer_service", "dispute_intake"] },
        "priority": { "enum": ["urgent", "normal"] },
        "reason_code": { "$ref": "#/$defs/reason_code" },
        "language": { "$ref": "#/$defs/language" },
        "source": { "$ref": "#/$defs/source" },
        "status": { "enum": ["filed", "claimed", "resolved"] },
        "queue_key": {
          "description": "The source, the queue, and the status, joined by #: the by_queue index's key, which a draft doesn't carry.",
          "type": "string",
          "pattern": "^(demo|evaluation)#(customer_service|dispute_intake)#(filed|claimed|resolved)$"
        },
        "queue_order": {
          "description": "The priority's rank, 1 for urgent and 0 for normal, and the filing time, joined by #: the by_queue index's sort key, so a descending query lists urgent cases first and each priority's newest first (ADR-0007's amendment of 2026-09-30).",
          "type": "string",
          "pattern": "^[01]#[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "saved_at": {
          "description": "When the case was saved as a draft, if it was one first.",
          "$ref": "#/$defs/wall_time"
        },
        "filed_at": { "$ref": "#/$defs/wall_time" },
        "claimed_at": { "$ref": "#/$defs/wall_time" },
        "claimed_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sub", "username"],
          "properties": {
            "sub": { "type": "string", "format": "uuid" },
            "username": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "resolved_at": { "$ref": "#/$defs/wall_time" },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "note"],
          "properties": {
            "outcome": { "enum": ["handled", "duplicate", "not_actionable"] },
            "note": { "$ref": "#/$defs/text", "maxLength": 500 }
          }
        },
        "flagged": { "type": "boolean" },
        "validation_errors": {
          "type": "array",
          "maxItems": 60,
          "items": { "$ref": "#/$defs/validation_error" }
        },
        "record": {
          "description": "Where the case's evidence is: the sign-in's execution record, and each turn whose entries the payload's evidence cites (ADR-0007's amendment of 2026-09-30).",
          "type": "object",
          "additionalProperties": false,
          "required": ["sign_in", "turns"],
          "properties": {
            "sign_in": { "$ref": "#/$defs/origin_jti" },
            "turns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/turn_prefix" }
            }
          }
        },
        "expires_at": { "$ref": "#/$defs/expires_at" }
      },
      "allOf": [
        {
          "if": { "properties": { "reason_code": { "const": "unrecognized_charge" } } },
          "then": { "properties": { "queue": { "const": "dispute_intake" } } },
          "else": { "properties": { "queue": { "const": "customer_service" } } }
        },
        {
          "if": { "properties": { "priority": { "const": "urgent" } } },
          "then": { "properties": { "queue_order": { "pattern": "^1#" } } },
          "else": { "properties": { "queue_order": { "pattern": "^0#" } } }
        },
        {
          "if": { "properties": { "flagged": { "const": true } } },
          "then": { "properties": { "validation_errors": { "minItems": 1 } } },
          "else": { "properties": { "validation_errors": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "status": { "const": "filed" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["claimed_at"] },
                { "required": ["claimed_by"] },
                { "required": ["resolved_at"] },
                { "required": ["resolution"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["claimed", "resolved"] } } },
          "then": { "required": ["claimed_at", "claimed_by"] }
        },
        {
          "if": { "properties": { "status": { "const": "resolved" } } },
          "then": { "required": ["resolved_at", "resolution"] },
          "else": { "not": { "anyOf": [{ "required": ["resolved_at"] }, { "required": ["resolution"] }] } }
        }
      ]
    },
    "reference_item": {
      "description": "Holds a reference for the one case that took it, so no two cases share one: file_handoff puts it on the condition that it doesn't exist, in the transaction that files the case, and the console finds a case by it (ADR-0007's amendment of 2026-09-30).",
      "type": "object",
      "additionalProperties": false,
      "required": ["pk", "kind", "reference", "handoff_id", "expires_at"],
      "properties": {
        "pk": {
          "description": "REF# and the reference.",
          "type": "string",
          "pattern": "^REF#[0-9A-HJKMNP-TV-Z]{4}-[0-9A-HJKMNP-TV-Z]{4}$"
        },
        "kind": { "const": "reference" },
        "reference": { "$ref": "#/$defs/reference" },
        "handoff_id": { "type": "string", "format": "uuid" },
        "expires_at": { "$ref": "#/$defs/expires_at" }
      }
    }
  }
}
