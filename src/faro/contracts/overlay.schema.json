{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banking-agent:card-support:overlay:1",
  "title": "Card support sandbox overlay item",
  "description": "One item of the sandbox's overlay, the sign-in's own layer over the tools' data (ADR-0004, Stores, and its amendment of 2026-10-01). Items are keyed by the sign-in (Cognito's origin_jti), then by item, and honored only in that sign-in and only for the customer they name. block_card writes a card's status; the evaluation's harness writes fixtures, merged into every Gateway tool's reads as if exported, and fault plans, which fail a tool's attempts. Every item expires with its ttl, at most 24 hours after it is written.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/card_status" },
    { "$ref": "#/$defs/fixture_card" },
    { "$ref": "#/$defs/fixture_transaction" },
    { "$ref": "#/$defs/fault_plan" }
  ],
  "$defs": {
    "sign_in": {
      "description": "The sign-in the item belongs to: Cognito's origin_jti, which Cedar matches to the token of every call that names it.",
      "type": "string",
      "format": "uuid"
    },
    "ttl": {
      "description": "Epoch seconds, at most 24 hours after the item is written, for DynamoDB's time to live.",
      "type": "integer",
      "minimum": 0
    },
    "fixture_card_id": {
      "description": "A fixture card's ID: PRD-FIXTURE and five characters, a prefix no card in the snapshot carries, so the ID tells a fixture from a record.",
      "type": "string",
      "pattern": "^PRD-FIXTURE[A-Z0-9]{5}$"
    },
    "fixture_transaction_id": {
      "description": "A fixture transaction's ID: TRX-FIXTURE and 13 characters, a prefix no transaction in the snapshot carries.",
      "type": "string",
      "pattern": "^TRX-FIXTURE[A-Z0-9]{13}$"
    },
    "gateway_tool": {
      "enum": ["list_cards", "get_card", "get_available_credit", "find_transactions", "block_card"]
    },
    "card_status": {
      "description": "A card's status as a block wrote it, under the confirmation's sign-in (POL-33, POL-37). The reads show it over the card's recorded status.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sign_in", "item", "customer_id", "card_id", "product_status", "reason", "confirmation_id", "written_at", "ttl"],
      "properties": {
        "sign_in": { "$ref": "#/$defs/sign_in" },
        "item": { "type": "string", "pattern": "^CARD#PRD-[A-Z0-9]{12}$" },
        "customer_id": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/customer_id" },
        "card_id": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/product_id" },
        "product_status": { "const": "Blocked" },
        "reason": { "enum": ["lost", "stolen", "unrecognized_charge", "customer_request"] },
        "confirmation_id": { "type": "string", "format": "uuid" },
        "written_at": { "type": "string", "format": "date-time" },
        "ttl": { "$ref": "#/$defs/ttl" }
      }
    },
    "fixture_card": {
      "description": "A card the snapshot lacks, such as a blocked or closed card with activity, or a second card of one type sharing last four digits (POL-15). It carries the export's card fields, with customer_id in place of pk and the overlay's item in place of sk, and the reads list it as if exported. item is FIXTURE#CARD# and the card's ID.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sign_in",
        "item",
        "customer_id",
        "kind",
        "card_id",
        "product_type",
        "last_four",
        "currency",
        "current_balance",
        "credit_limit",
        "product_status",
        "opening_date",
        "expiration_date",
        "past_expiration",
        "updated_after_as_of",
        "ttl"
      ],
      "properties": {
        "sign_in": { "$ref": "#/$defs/sign_in" },
        "item": { "type": "string", "pattern": "^FIXTURE#CARD#PRD-FIXTURE[A-Z0-9]{5}$" },
        "customer_id": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/customer_id" },
        "kind": { "const": "card" },
        "card_id": { "$ref": "#/$defs/fixture_card_id" },
        "product_type": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/card_item/properties/product_type" },
        "last_four": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/card_item/properties/last_four" },
        "currency": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/card_item/properties/currency" },
        "current_balance": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/card_item/properties/current_balance" },
        "credit_limit": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/card_item/properties/credit_limit" },
        "product_status": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/card_item/properties/product_status" },
        "opening_date": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/card_item/properties/opening_date" },
        "expiration_date": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/card_item/properties/expiration_date" },
        "past_expiration": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/card_item/properties/past_expiration" },
        "updated_after_as_of": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/card_item/properties/updated_after_as_of" },
        "ttl": { "$ref": "#/$defs/ttl" }
      }
    },
    "fixture_transaction": {
      "description": "A transaction the snapshot lacks, on one of the customer's cards, real or a fixture: an unlisted code, a merchant name that carries an injection, or enough transactions for a second page. It carries the export's transaction fields, is_fraud included, with customer_id in place of pk and the overlay's item in place of sk. The tools check what this contract can't, and fail the call when one doesn't hold: item is FIXTURE#TRX# and the transaction's ID, card_key is the customer's ID and the card's, and listed_at is the transaction's date and ID. It is listed on its card only, so one on a card the customer doesn't hold is never shown, and one outside the 90-day window is left out, as the export would leave it. Only file_handoff reads is_fraud (POL-40). item is FIXTURE#TRX# and the transaction's ID.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sign_in",
        "item",
        "customer_id",
        "kind",
        "card_key",
        "listed_at",
        "transaction_id",
        "card_id",
        "transaction_date",
        "transaction_type",
        "amount",
        "currency",
        "channel",
        "merchant_name",
        "merchant_category",
        "transaction_country",
        "transaction_status",
        "response_code",
        "is_fraud",
        "before_card_opening",
        "after_card_expiration",
        "ttl"
      ],
      "properties": {
        "sign_in": { "$ref": "#/$defs/sign_in" },
        "item": { "type": "string", "pattern": "^FIXTURE#TRX#TRX-FIXTURE[A-Z0-9]{13}$" },
        "customer_id": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/customer_id" },
        "kind": { "const": "transaction" },
        "card_key": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/card_key" },
        "listed_at": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/listed_at" },
        "transaction_id": { "$ref": "#/$defs/fixture_transaction_id" },
        "card_id": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/product_id" },
        "transaction_date": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/transaction_date" },
        "transaction_type": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/transaction_type" },
        "amount": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/amount" },
        "currency": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/currency" },
        "channel": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/channel" },
        "merchant_name": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/merchant_name" },
        "merchant_category": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/merchant_category" },
        "transaction_country": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/transaction_country" },
        "transaction_status": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/transaction_status" },
        "response_code": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/response_code" },
        "is_fraud": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/is_fraud" },
        "before_card_opening": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/before_card_opening" },
        "after_card_expiration": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/transaction_item/properties/after_card_expiration" },
        "ttl": { "$ref": "#/$defs/ttl" }
      }
    },
    "fault_plan": {
      "description": "Fails a Gateway tool's attempts in the sign-in (EVL-06, POL-48). Each attempt at the tool takes one failure, across calls, until none is left: with POL-48's two retries, 1 or 2 failures recover within the call, and 3 end it with tool_failure offered. The tool answers a planned attempt with its fault output before it reads anything, and the Runtime records it as failed with this error and planned. The harness writes failures from 1 to 9; the tools count it down, in a conditional update, so a spent plan reads 0. item is FAULT# and the tool's name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sign_in", "item", "customer_id", "tool", "failures", "error", "ttl"],
      "properties": {
        "sign_in": { "$ref": "#/$defs/sign_in" },
        "item": {
          "type": "string",
          "pattern": "^FAULT#(list_cards|get_card|get_available_credit|find_transactions|block_card)$"
        },
        "customer_id": { "$ref": "urn:banking-agent:card-support:tools-data:1#/$defs/customer_id" },
        "tool": { "$ref": "#/$defs/gateway_tool" },
        "failures": { "type": "integer", "minimum": 0, "maximum": 9 },
        "error": {
          "description": "The tool_call error code each planned attempt is recorded with: the execution record's codes but transport, which a plan can't name, and denied, which only Cedar gives.",
          "enum": ["timeout", "throttled", "lambda_error"]
        },
        "ttl": { "$ref": "#/$defs/ttl" }
      }
    }
  }
}
