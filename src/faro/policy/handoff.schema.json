{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:banking-agent:card-support:handoff:1",
  "title": "Card support handoff",
  "description": "What the card support agent hands a person (CTL-05), under docs/policy/card-support.md (POL-45 to POL-47). Facts come from tool calls; what the customer says stays apart from them. No transcript, and no full card number.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_id",
    "created_at",
    "session_id",
    "customer_id",
    "versions",
    "business_date",
    "language",
    "queue",
    "priority",
    "trigger",
    "reason_code",
    "rules",
    "request",
    "verified_facts",
    "actions",
    "evidence",
    "customer_statements",
    "unresolved_questions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "handoff_id": { "type": "string", "format": "uuid" },
    "created_at": {
      "description": "Wall clock.",
      "type": "string",
      "format": "date-time"
    },
    "session_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "customer_id": { "$ref": "#/$defs/customer_id" },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "snapshot"],
      "properties": {
        "policy": { "type": "integer", "minimum": 1 },
        "snapshot": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    },
    "business_date": {
      "description": "The frozen bank's today, which banking logic reads (POL-19).",
      "type": "string",
      "format": "date"
    },
    "language": {
      "description": "The language to answer the customer in (POL-50).",
      "enum": ["es", "pt"]
    },
    "queue": { "enum": ["customer_service", "dispute_intake"] },
    "priority": { "enum": ["urgent", "normal"] },
    "trigger": {
      "description": "Whether the policy required the handoff or the customer accepted an offer (POL-45).",
      "enum": ["required", "accepted_offer"]
    },
    "reason_code": {
      "enum": [
        "unrecognized_charge",
        "customer_request",
        "complaint",
        "unblock_request",
        "customer_not_active",
        "ambiguous_card",
        "action_not_verified",
        "block_lapsed",
        "unsupported_request",
        "clarification_failed",
        "record_conflict",
        "missing_data",
        "tool_failure"
      ]
    },
    "rules": {
      "description": "The policy rules that required or offered the handoff.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^POL-[0-9]{2}$" }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "summary"],
      "properties": {
        "label": {
          "enum": [
            "card_status",
            "available_credit",
            "recent_transactions",
            "decline_reason",
            "block_card",
            "unrecognized_charge",
            "unsupported",
            "talk_to_human"
          ]
        },
        "summary": { "$ref": "#/$defs/text", "maxLength": 500 }
      }
    },
    "verified_facts": {
      "type": "array",
      "maxItems": 60,
      "items": { "$ref": "#/$defs/fact" }
    },
    "actions": {
      "description": "Actions taken, and blocks offered that the customer didn't confirm (POL-36).",
      "type": "array",
      "maxItems": 10,
      "items": { "$ref": "#/$defs/action" }
    },
    "evidence": {
      "type": "array",
      "maxItems": 60,
      "items": { "$ref": "#/$defs/tool_call" }
    },
    "customer_statements": {
      "description": "What the customer says and no tool verified.",
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/text", "maxLength": 280 }
    },
    "unresolved_questions": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/text", "maxLength": 280 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "reason_code": { "const": "unrecognized_charge" } } },
      "then": { "properties": { "queue": { "const": "dispute_intake" } } },
      "else": { "properties": { "queue": { "const": "customer_service" } } }
    }
  ],
  "$defs": {
    "customer_id": { "type": "string", "pattern": "^CLI-[A-Z0-9]{12}$" },
    "product_id": { "type": "string", "pattern": "^PRD-[A-Z0-9]{12}$" },
    "transaction_id": { "type": "string", "pattern": "^TRX-[A-Z0-9]{20}$" },
    "call_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "text": {
      "description": "Free text, in Spanish (POL-46). A run of 13 or more digits, spaced or not, could be a card number, so it is rejected (POL-11).",
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "[0-9](?:[ -]?[0-9]){12,}" }
    },
    "fact": {
      "description": "One field of one record, as a tool read it. A null value means the record doesn't hold it (POL-32).",
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "id", "field", "value", "evidence"],
      "properties": {
        "subject": { "enum": ["customer", "card", "transaction"] },
        "id": { "type": "string" },
        "field": { "type": "string" },
        "value": { "type": ["string", "number", "boolean", "null"] },
        "evidence": { "$ref": "#/$defs/call_id" }
      },
      "allOf": [
        {
          "if": { "properties": { "subject": { "const": "customer" } } },
          "then": {
            "properties": {
              "id": { "$ref": "#/$defs/customer_id" },
              "field": { "enum": ["customer_status", "country"] }
            }
          }
        },
        {
          "if": { "properties": { "subject": { "const": "card" } } },
          "then": {
            "properties": {
              "id": { "$ref": "#/$defs/product_id" },
              "field": {
                "enum": [
                  "product_type",
                  "last_four",
                  "product_status",
                  "currency",
                  "credit_limit",
                  "current_balance",
                  "available_credit",
                  "over_limit_by",
                  "opening_date",
                  "expiration_date",
                  "past_expiration"
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "subject": { "const": "transaction" } } },
          "then": {
            "properties": {
              "id": { "$ref": "#/$defs/transaction_id" },
              "field": {
                "enum": [
                  "product_id",
                  "transaction_date",
                  "transaction_type",
                  "transaction_status",
                  "response_code",
                  "amount",
                  "currency",
                  "merchant_name",
                  "merchant_category",
                  "channel",
                  "transaction_country",
                  "is_fraud",
                  "before_card_opening",
                  "after_card_expiration"
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "field": { "const": "last_four" } } },
          "then": { "properties": { "value": { "type": "string", "pattern": "^[0-9]{4}$" } } }
        },
        {
          "if": { "properties": { "field": { "const": "product_id" } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/product_id" } } }
        },
        {
          "if": { "properties": { "value": { "type": "string" } } },
          "then": { "properties": { "value": { "$ref": "#/$defs/text", "maxLength": 280 } } }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "card_id", "reason", "confirmation_id", "outcome", "confirmed_at", "evidence"],
      "properties": {
        "action": { "const": "block_card" },
        "card_id": { "$ref": "#/$defs/product_id" },
        "reason": { "enum": ["lost", "stolen", "unrecognized_charge", "customer_request"] },
        "confirmation_id": {
          "description": "The confirmation the server created when it showed the confirm control, used or not (POL-36).",
          "type": "string",
          "format": "uuid"
        },
        "outcome": {
          "description": "verified: the sandbox read back Blocked. not_verified: it didn't, so the card's state is unknown (POL-37). declined_by_customer: the customer cancelled with the confirm control. lapsed: the confirmation ended unused otherwise: on a new request, an accepted handoff, its time limit, or the session's end (POL-36).",
          "enum": ["verified", "not_verified", "declined_by_customer", "lapsed"]
        },
        "confirmed_at": { "type": ["string", "null"], "format": "date-time" },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/call_id" }
        }
      },
      "if": { "properties": { "outcome": { "enum": ["declined_by_customer", "lapsed"] } } },
      "then": { "properties": { "confirmed_at": { "type": "null" } } },
      "else": {
        "properties": {
          "confirmed_at": { "type": "string" },
          "evidence": { "minItems": 1 }
        }
      }
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call_id", "tool", "called_at", "outcome"],
      "properties": {
        "call_id": { "$ref": "#/$defs/call_id" },
        "tool": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "called_at": { "type": "string", "format": "date-time" },
        "outcome": { "enum": ["ok", "error", "denied"] }
      }
    }
  }
}
